{
  "expo": {
    "name": "Hisobh",
    "slug": "hisobh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisobh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFA938"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisobh.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFA938",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.hisobh.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hisobh to use Face ID for secure authentication."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Expense Ledger needs access to your photos to attach bill and receipt photos.",
          "cameraPermission": "Expense Ledger needs camera access to take photos of physical bills and receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3f666b35-166c-4921-9765-ebc7e8f7461f"
      }
    }
  }
}
